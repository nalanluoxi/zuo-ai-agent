# ============================================
#  环境变量模板 - 复制为 .env 后填入实际值
#  cp .env.example .env
# ============================================

# === 数据库 ===
DB_URL=jdbc:postgresql://<RDS内网地址>:5432/zuo_ai_agent
DB_USERNAME=zuo_ai
DB_PASSWORD=your_db_password

# === Redis ===
REDIS_HOST=<Redis内网地址>
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# === RabbitMQ ===
RABBITMQ_HOST=<RabbitMQ内网地址>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password

# === LLM API Key ===
DASHSCOPE_API_KEY=your_dashscope_api_key
SILICONFLOW_API_KEY=your_siliconflow_api_key

# === ACR 镜像仓库（用于 GitHub Actions 推送） ===
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your_namespace
ACR_USERNAME=your_acr_username
ACR_PASSWORD=your_acr_password

# === 服务器部署 ===
SERVER_HOST=your_server_ip
SERVER_USER=root
SERVER_PORT=22
